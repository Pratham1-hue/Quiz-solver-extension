# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=apikey_018Nd1vpv7vd2VEdAaw4vzP4

# Models (override as needed)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_ESCALATION_MODEL=claude-opus-5-5
ESCALATE_LOW_CONFIDENCE=true
CONFIDENCE_THRESHOLD=0.7

# Guards
MAX_CONCURRENT_CLAUDE_CALLS=4
MAX_ANALYSES_PER_SESSION=200
CACHE_TTL_S=604800
CACHE_MAX_ITEMS=5000

# CORS: only your own extension. Replace with your extension's real ID once loaded,
# e.g. ^chrome-extension://abcdefghijklmnopabcdefghijklmnop$
ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
